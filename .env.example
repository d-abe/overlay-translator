# Overlay Translator - 環境変数設定
# このファイルをコピーして .env ファイルを作成し、実際の値を設定してください

# ============================================
# ホットキー設定
# ============================================
# 矩形選択を開始するホットキーを設定
# 形式: 複数のキーは「+」で区切ります
# 例: ctrl+shift+t, alt+f1, ctrl+alt+s
# デフォルト: ctrl+shift+t
HOTKEY=ctrl+shift+t

# ============================================
# Groq API設定（翻訳用）
# ============================================
# Groq APIキーを設定してください
# 取得方法: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 使用するGroqモデルを指定
# 利用可能なモデル:
# - llama-3.1-8b-instant (デフォルト・推奨)
# - llama-3.3-70b-versatile
# - openai/gpt-oss-120b
# - openai/gpt-oss-20b
# - meta-llama/llama-4-maverick-17b-128e-instruct (Preview)
# - meta-llama/llama-4-scout-17b-16e-instruct (Preview)
GROQ_MODEL=llama-3.1-8b-instant

# Groq Vision API用モデル（OCRでGroq Visionを使用する場合）
# - meta-llama/llama-4-scout-17b-16e-instruct (デフォルト・高速)
# - meta-llama/llama-4-maverick-17b-128e-instruct (高品質)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ============================================
# Google Cloud Vision API設定（OCR用）
# ============================================
# 方法1: APIキーを使用（簡単）
# Google Cloud ConsoleでAPIキーを作成して設定
GOOGLE_API_KEY=your_google_api_key_here

# 方法2: サービスアカウントJSONファイルを使用（推奨）
# サービスアカウントキー（JSON）のパスを設定
# GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# ============================================
# OCR方法の選択
# ============================================
# OCRエンジンを選択:
# - google: Google Cloud Vision APIを使用（高精度・請求が必要）
# - groq: Groq Vision APIを使用（高速・Groq APIキー使用）
# - easyocr: EasyOCRライブラリを使用（オフライン・初回のみモデルダウンロード）
# 指定しない場合: 自動的にGoogle Visionを試し、失敗したらEasyOCRにフォールバック
OCR_METHOD=google

# ============================================
# オーバーレイ表示設定
# ============================================
# オーバーレイウィンドウで使用するフォントファミリー
# 日本語対応フォント: Meiryo, MS Gothic, MS PGothic, Yu Gothic, MS Mincho
# 英語フォント: Arial, Times New Roman, Courier New
# デフォルト: Meiryo
OVERLAY_FONT_FAMILY=Meiryo

# オーバーレイウィンドウで使用するフォントサイズ
# 8から72の間で指定
# デフォルト: 12
OVERLAY_FONT_SIZE=12

# オーバーレイウィンドウで使用するフォントスタイル
# normal: Regular（通常）
# bold: Bold（太字）
# italic: Italic（斜体）
# bold italic: Bold Italic（太字斜体）
# デフォルト: normal
OVERLAY_FONT_STYLE=normal

# その他の利用可能なモデル: openai/gpt-oss-20b, meta-llama/llama-4-maverick-17b-128e-instruct など
# 最新のモデルリスト: https://console.groq.com/docs/models